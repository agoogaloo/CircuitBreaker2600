50	processor 6502
        include "vcs.h"
        include "macro.h"
        include "xmacro.h"

;;;; [TODO] ;;;;;
; shmoovement
; [X]	fractional position?	
; [ ]	friction
; [ ]	boosting/energy
;
; [X] collision resolution
;
; game logic
; [X]	laps counter/detection
; [ ]	timer

;title/different maps/modes?
;;;;;;;;;;;;;;;;;

SpriteHeight	equ 9
AnimOffset	equ 9
EndAnim		equ 12
EndBoostAnim	equ 30
LapsHeight	equ 192 - 10

NormAccel	equ 12
BoostAccel	equ 30

MaxEnergy	equ 175



;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Variables segment

        seg.u Variables
	org $80
        
; game state
; 0-> racing
; 1-> countdown
; 2-> p1 win
; 3-> p2 win
State		.byte
Timer		.word


; movement
P1PrevPos	.word
P2PrevPos	.word

P1PosX		.byte
P1PosY		.byte
P2PosX		.byte
P2PosY		.byte

; fractional position for fixed point
P1PosFX		.byte
P1PosFY		.byte
P2PosFX		.byte
P2PosFY		.byte

P1VelX		.byte
P1VelY		.byte
P2VelX		.byte
P2VelY		.byte

; fractional velocity for fixed point
P1VelFX		.byte
P1VelFY		.byte
P2VelFX		.byte
P2VelFY		.byte

; energy counter. should be 2 bytes apprt for easier addressing
P1Energy	.byte
Temp		.byte	; used for various things
P2Energy	.byte

; sprite/animation
P1FramePtr	.word
P2FramePtr	.word

P1Anim		.byte
PFCounter	.byte	; why did I decide to space players apart by 2 bytes...
P2Anim		.byte

; laps
P1Laps		.byte
P1LapLoc	.byte	
P2Laps		.byte
P2LapLoc	.byte

; scoreboard buffer
LapsBuff	.ds 10


Temp2		.byte	; the movement code (and maybe other stuff later) needs another random byte
TrackPtr	.word



;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Code segment

	seg Code
        org $f000

Start
Reset
	CLEAN_START
; init
; player position/colours
        lda #40
        sta P1PosY
        sta P2PosY
        lda #60
        sta P1PosX
        lda #100
        sta P2PosX
        lda #$1F
        sta COLUP0
        lda #$5e
        sta COLUP1
        
; lap counter
        lda #$5
        sta P1Laps
        sta P2Laps
         
; sprite frames
        lda #<FrameU0
        sta P1FramePtr
	sta P2FramePtr
        lda #>FrameU0
        sta P1FramePtr+1
        sta P2FramePtr+1
        
        lda #MaxEnergy
        sta P1Energy
        sta P2Energy
        
; track pointer
	lda #<TrackData
        sta TrackPtr
        lda #>TrackData
        sta TrackPtr+1
        
; vertical delay on p0 so they are both synced to the right scanline        
        lda #1
        sta VDELP0
        lda #0
        sta State
        
        
        
; main loop
NextFrame
        lsr SWCHB	; test Game Reset switch
        bcc Start	; reset?
; 1 + 3 lines of VSYNC
	VERTICAL_SYNC
; 37 lines of underscan
	TIMER_SETUP 37
; check state, and update accordingly
        lda State
        beq RaceUpdate
        cmp #2
        beq P1WinUpdate
        cmp #3
        beq P2WinUpdate
        
;;;;; -[Win Screen Update]- ;;;;;       
P1WinUpdate
P2WinUpdate
	bit INPT4	; reset if either button is pushed
        bpl Reset
        bit INPT5
        bpl Reset
        jmp EndUpdate



;;;;; -[Race Update]- ;;;;
RaceUpdate

; timer updates
	inc Timer	; global timer
        bne NoTimerCarry
        inc Timer+1
NoTimerCarry
        
; animation!
; could probably be condesed for more ROM space if needed
	lda Timer	; check if frame is multiple of 4
        and #1		; take 0th bit
        bne P2AnimIncr	; next frame
        lda #AnimOffset	; offset between animation frames
        clc		
        adc P1Anim
        cmp #EndBoostAnim
        bcc P1NoResetAnim
        lda #0
P1NoResetAnim
        sta P1Anim
        jmp DoneAnimIncr 
        
P2AnimIncr
	
	lda #AnimOffset	; offset between animation frames
        clc		
        adc P2Anim
        cmp #EndBoostAnim
        bcc P2NoResetAnim
        lda #0
P2NoResetAnim
        sta P2Anim
DoneAnimIncr

; move X and Y coordinates w/ joystick
; give player in x register
	ldx #0
	jsr MoveJoystick
        ldx #2
        jsr MoveJoystick
        
; apply velocity/collision
	lda Timer
	ldy #0
	jsr WallCollision
        lda Timer
        ldy #2
        jsr WallCollision

; finish line triggers
	bit CXP0FB
        bvc NoP1Lap
        ldx #0
        jsr CheckLaps
NoP1Lap

	bit CXP1FB
        bvc NoP2Lap
        ldx #2
        jsr CheckLaps
NoP2Lap

	

	sta CXCLR	; reset collision flags after we finish all collisions

	
        
; update scoreboard bitmaps
	lda P1Laps
        
        ldx #0
	jsr LapsBitmap
        lda P2Laps
        ldx #5
        jsr LapsBitmap
        
; the next two scanlines
; position the player horizontally
	lda P1PosX	; get X coordinate
        ldx #0		; player 0
        jsr SetHorizPos	; set coarse offset
        lda P2PosX	; get X coordinate
        ldx #1		; player 0
        jsr SetHorizPos	; set coarse offset
        lda #4
        ldx #2		; missile/energy bar pos
        jsr SetHorizPos
        lda #161 - 4
        ldx #3		; missle/energy bar pos
        jsr SetHorizPos
        lda #80
        ldx #4		; missle/energy bar pos
        jsr SetHorizPos
        sta WSYNC	; sync w/ scanline
        sta HMOVE	; apply fine offsets
     
EndUpdate
; setup for laps counter
        lda #0
        sta ENAM0
        sta ENAM1
        sta PF0
        sta PF1
        sta PF2
        lda #$d0
        sta COLUBK
        ;sta COLUPF
        lda #2
        sta CTRLPF
        

; it's ok if we took an extra scanline because
; the PIA timer will always count 37 lines
; wait for end of underscan
        TIMER_WAIT
        lda #0
        sta VBLANK
	
       
; 192 lines of frame
	ldx #192	; X = 192 scanlines
        ldy #0
        
; drawing kernel
LapsLoop
	
        ;lsr		; double height
        lda LapsBuff,y
        sta PF1
        
        SLEEP 28
        
        lda LapsBuff+5,y
        sta PF1
        
	dex
        txa
        and #1
        bne CopyLapLine
        iny
CopyLapLine
        
        sta WSYNC
        cpx #LapsHeight
        bne LapsLoop
 
 	lda #0
        sta PF1  
        sta PFCounter
        dex
        sta WSYNC
        lda #$01
        sta CTRLPF
        lda #$c3
        sta COLUBK
        lda #$D8
        sta COLUPF 
        dex
        sta WSYNC
       
      
; draw the actual game
FieldLoop

; P1 energy bar
	lda #0		; dont draw
        cpx P1Energy 	; is row < energy ?
        bcs SkipBar1
        lda #3
        ;txa		; draw dashed line
SkipBar1
	sta ENAM0	; update if we draw line

; P2 energy bar
        lda #0
	cpx P2Energy	
        bcs SkipBar2
        txa
SkipBar2
	sta ENAM1	; draw missile (for the bar)

; draw playfield/map
       	txa		; height on the screen
        and #7		
        bne NoFieldIncr	; increment index every 8 pixels
    	lda #3
        clc
	adc PFCounter	; add 3 bytes to go to the next index
	sta PFCounter
        
NoFieldIncr
	
	ldy PFCounter 	; load current location in the playfield
	lda (TrackPtr),y
        pha		; put byte 0 onto the stack
        iny
      	lda (TrackPtr),y ; load the 2nd byte
        iny
        
        sta WSYNC	; start the next line
        dex
        
       
        sta PF1		; set the 2nd byte we just loaded
        lda (TrackPtr),y
        sta PF2		; set the 3rd byte
        pla 
        sta PF0		; set byte 0 from the stack
        
; draw finish line
	stx ENABL

	
DrawP1     
; draw p1
	txa		; X -> A
        sec		; set carry for subtract
        sbc P1PosY	; local coordinate
        lsr
        cmp #SpriteHeight ; in sprite?
        bcc InSprite1	; yes, skip over next
        lda #0		; not in sprite, load 0

InSprite1
	
	;clc		; clear for addition (extra buffer is added instead to save the clock cycles)
        adc P1Anim	; add animation offset
        
	tay		; local coord + frame -> Y
        lda (P1FramePtr),y	; lookup frame line
       
        sta GRP0	; store bitmap
       
; draw p2
	txa 
        sec
        sbc P2PosY
        lsr
        cmp #SpriteHeight
        bcc InSprite2
        lda #0		;use bottom clear row if not in sprite
        
InSprite2
	;clc
        adc P2Anim
	tay
        
SkipP2
        sta WSYNC	; sync w/ scanline
        lda (P2FramePtr),y
        sta GRP1
        dex		; decrement X
        
        bne FieldLoop	; repeat until 192 lines

; 29 lines of overscan
	TIMER_SETUP 29
        TIMER_WAIT
; total = 262 lines, go to next frame
        jmp NextFrame

; update laps when lap line is hit
; preconditions: 
; x-> playerNum (0/2)
CheckLaps	subroutine
	lda P1PosY,x	; get y position
        cmp #192/2 
        bcc .BotLine	; if negative we're on the Bottom
       	lda P1LapLoc,x	
        
        beq .Return	; last touch was also on top, don't count 
        sed		;set decimal mode for changing laps
        lda P1Laps,x	; decrement lap counter
        sbc #1
        sta P1Laps,x
        
        cld
        beq .WinGame
	lda #0		
        sta P1LapLoc,x
        rts
.BotLine
	lda P1LapLoc,x	
        bne .Return	; last touch was also on top, don't count 
        sed
        lda P1Laps,x	; decrement lap counter
        sbc #0		; we already brnached from the carry, so we dont need to clear it
        sta P1Laps,x	; need to do this the long way because BCD
        cld
        beq .WinGame

        		
	lda #1		; store 1 to indicate side we touched
        sta P1LapLoc,x
.Return
	rts
.WinGame
	txa
        lsr		; convert to 2/3 for player 1/2 win
        ora #2
        sta State	; win state!
        lda Timer+1	; record time
        sta P1Laps
        lda Timer
        sta P2Laps
        lda #0
        sta Timer
        sta Timer+1
	rts
        
        
; preconditions: 
; a-> frame counter (x or y collision)
; on even, move x, check y for collision from last frame
; y-> playerNum (0/2) 
WallCollision	subroutine       
	and #1		; take last bit of frame#
        sty Temp
        clc		; add a and y to get offset of data
        adc Temp
        tay		; y now has offset of the axis we are resolving

; move position based on velocity      
        clc		; clear carry for addition
        lda P1VelFX,y	
        adc P1PosFX,y	; add fractional parts 
        sta P1PosFX,y
        
        lda P1PosX,y	; add whole number parts with carry from fraction
        sta P1PrevPos,y	;store initial position in case of collision
        adc P1VelX,y
        sta P1PosX,y

        
; player/wall collision
; this operates on the axis fom last frame, not this frame
        cpy #2		; compare player num in y
        bcs .P2Reg	; check player number
        bit CXP0FB	; get sprite/wall collision
        bpl .NoWall	; no collision
        jmp .RestoreVal	; restore movement from previous frame
.P2Reg
	bit CXP1FB
        bpl .NoWall
        
.RestoreVal
	tya
        eor #1		; flip x/y bit because we are checking collision from last frame
        tay
        
        lda #0
        sta P1VelX,y	; stop velocity
        sta P1VelFX,y
       
        lda P1PrevPos,y	; reset position 
        sta P1PosX,y
        
       
.NoWall
	rts

; pre conditions: x=offset into array ,a=BCD number
LapsBitmap	subroutine
	
	pha 		; push a for later
        and #$0f 	; mask out 1st digit
; multiply by 5 to get location of bitmap
        sta Temp
        asl
        asl
        adc Temp
        tay		; store in y
        lda #5		
        sta Temp	; loop through each row
.digit1
	lda DigitsBitmap,y
        and #$0f	; get 1st digit
        sta LapsBuff,x	; store it
        inx
        iny		;update counters
        dec Temp
       	bne .digit1
; 2nd digit        
        pla		; restore original value
        lsr
        lsr
        lsr
        lsr
        sta Temp	; store 2nd digit * 4
        asl
        asl
        adc Temp	
        tay		; digit* 5 (bitmap offset) is in y
        dex
        dex		; restore x back to original value
        dex
        dex
        dex
        lda #5
        sta Temp
.digit2
	lda DigitsBitmap,y
        and #$F0	; take left digit
	ora LapsBuff,x	; combine with 1st digit
        sta LapsBuff,x	; store back
        inx
        iny		; update counters
        dec Temp
        bne .digit2
        
	rts

; SetHorizPos routine
; A = X coordinate
; X = player number (0 or 1)
SetHorizPos	subroutine
	sta WSYNC	; start a new line
        bit 0		; waste 3 cycles
	sec		; set carry flag
DivideLoop
	sbc #15		; subtract 15
	bcs DivideLoop	; branch until negative
	eor #$7		; calculate fine offset
	asl
	asl
	asl
	asl
	sta RESP0,x	; fix coarse position
        ;lda #$80
	sta HMP0,x	; set fine offset
	rts		; return to caller


; Read joystick movement/boost and apply to 
; x is 0 for p1, 2 for p2
; this could be split by axis per frame like movement if more time is needed
; (could also just stop useing indirect addressing for everythihg)
MoveJoystick	subroutine

; Find which axis has larger motion
; this whole thing basically just does if(abs(x)>abs(y))
; take absolute value for yvelocity
        lda P1VelY,x
        bpl .PositiveY	; y velocity is already positive
        lda #$ff
        sec
        sbc P1VelY,x	; 0 - P1Vel
        sta Temp	; store in Temp
        lda #0
        sec 
        sbc P1VelFY,x 	; apply to fractional component too
        sta Temp2 
        jmp .DoneAbsY
.PositiveY
	sta Temp
        lda P1VelFY,x
        sta Temp2
.DoneAbsY

; absolute val for X velocity
        lda P1VelX,x
        bpl .PositiveX	; y velocity is already positive
        lda #$0
        sec
        sbc P1VelFX,x	; 0 - P1Vel
        tay		; store in y register
        lda #$ff		; do whole component last so it ends in a register
        sec 
        sbc P1VelX,x 	; apply to fractional component too
        ;sta Temp2 
        jmp .DoneAbsX
.PositiveX
        lda P1VelFX,x
        tay
        lda P1VelX,x
.DoneAbsX
; now Temp = abs(velY) whole, Temp2 = abs(velY) fraction
; a = abs(velX) whole, y = abs(velX) fraction
        
        cmp Temp	; compare whole components
        bcc .BigYVel	; whole compoent of y is bigger
        bne .BigXVel	; not equal -> whole of X is bigger
        cmp #0		; if x and y velocities are less than 1, just ignore
        beq .DoneVelCheck
        tya		
        cmp Temp2	; whole compoent was equal -> check fractions
        bcc .BigYVel	; fraction of y is bigger
        bne .BigXVel	; not equal -> fraction of X is bigger
        lda #0
        jmp .DoneVelCheck
.BigYVel
	lda #$80
        jmp .DoneVelCheck
.BigXVel
	lda #$40
.DoneVelCheck
	; 100..0 = y bigger, 01..00 = x bigger
	sta Temp2 ; store indicator in Temp2
        sta P1Laps,x



        
; boost input
; stores the speed in Temp
	txa 		; check player number
        bne P2Boost	
        bit INPT4	; check p1 boost input
        bpl .boost
        jmp .NoBoost
P2Boost
	bit INPT5	; check p2 boost input
        bpl .boost
        jmp .NoBoost
	
.boost  		; do the boost
	lda P1Energy,x
        sec
	sbc #2		; consume 2 boost meter
        bcc .NoBoost	; don't boost if you don't have enought energy
        sta P1Energy,x
	lda #BoostAccel ; store acceleration in Temp
        sta Temp
        jmp .EndBoost

.NoBoost		; don't boost
	lda #NormAccel ; store normal acceleration
        sta Temp
        		 
        lda #EndAnim	; only do the 1st 2 frames of animation
        cmp P1Anim,x	
        bcs .NoAnimReset; don't need to reset
        lda #0		; go back to frame 1
        sta P1Anim,x
.NoAnimReset
.EndBoost



	
       
; modify velocity from inputs       
; y axis:
	ldy P1VelFY,x	; store fractional yVel in y register
        txa
        bne .P2Down	; use p2 bitmask/velocity
        lda #%00100000	; else, use p1 bitmask        
        jmp .DownDone
.P2Down
	lda #%00000010	
.DownDone
	bit SWCHA	; pressed?
	bne .SkipMoveDown	; if not, skip moving down
     
       	lda #<FrameD0	; change frame
        sta P1FramePtr,x
        lda #>FrameD0 
        sta P1FramePtr+1,x
        
        ; subtract Temp from fractional velocity
        tya
        sec
        sbc Temp
        tay
        bcs .SkipMoveDown
        dec P1VelY,x	; apply to whole velocity if it overflowed
      
        
.SkipMoveDown

; check up direction
	txa
        bne .P2Up
        lda #%00010000	;Up
        jmp .UpDone
.P2Up
	lda #%00000001	;Up on p2 controller
.UpDone
	bit SWCHA 
	bne .SkipMoveUp
        
        lda #<FrameU0	;set animation
        sta P1FramePtr,x
        lda #>FrameU0 
        sta P1FramePtr+1,x
        
       	; add Temp to fractional velocity
        tya
        clc
        adc Temp
        tay
        bcc .SkipMoveUp
        inc P1VelY,x
        
.SkipMoveUp
	
	tya
	cmp P1VelFY,x
        beq .NoChangeY	; check if we acually moved in y axis
	sta P1VelFY,x	; update value
        
; check for drift
        bit Temp2	; check priamry velocity direction
        bvc .NoChangeY	; 
        lda #MaxEnergy
     	cmp P1Energy,x
        bcc .NoChangeY
        
        inc P1Energy,x	; add energy if velocity is in x axis
        
.NoChangeY   
        

; horizontal velocity
	ldy P1VelFX,x
; check left
        txa
        bne .P2Left
        lda #%01000000
        jmp .LeftDone
.P2Left
	lda #%00000100
.LeftDone
; Move horizontally
	bit SWCHA
	bne .SkipMoveLeft
; set frame
        lda #<FrameL0
        sta P1FramePtr,x
        lda #>FrameL0 
        sta P1FramePtr+1,x
; subtract
	tya
        sec
        sbc Temp
        tay
        bcs .SkipMoveLeft
        dec P1VelX,x
       	
.SkipMoveLeft

; get right input
	txa
        bne .P2Right
        lda #%10000000		
        jmp .RightDone
.P2Right
	lda #%00001000		;Right?
.RightDone	
	bit SWCHA 
	bne .SkipMoveRight
        
        ; set frame
        lda #<FrameR0
        sta P1FramePtr,x
        lda #>FrameR0 
        sta P1FramePtr+1,x
; add to fractional velocity
        tya
        clc
        adc Temp
        tay
        bcc .SkipMoveRight
        inc P1VelX,x
        
.SkipMoveRight
	tya
	cmp P1VelFX,x
        beq .NoChangeX	; check if we acually moved in y axis
	sta P1VelFX,x	; update value
        
; check for drift
        bit Temp2	; check priamry velocity direction
        bpl .NoChangeX	; 
        lda #MaxEnergy
     	cmp P1Energy,x
        bcc .NoChangeX
        
        inc P1Energy,x	; add energy if velocity is in x axis
.NoChangeX
	rts

; preconditions:
; Temp2 = #$FF
; a = Value to get abs
; negative flag set correctly
AbsVal	subroutine
	; Find which axis has larger motion
        bpl .PositiveY	; y velocity is already positive
        eor Temp2
        clc
        adc #1
        lda #0
        sec		; 0 - yVel to get the absolute value		
        sbc P1VelY,x
.PositiveY
        rts
        
	align #$100   	; make address aligned or it takes too long to look up   
;Animations
FrameU0
	.byte #0,#0
        .byte #%00000000;$1E
        .byte #%00000000;$1E
        .byte #%00100010;$1E
        .byte #%01110111;$1E
        .byte #%01011101;$1E
        .byte #%00010100;$1E
        .byte #%00001000;$1E

	.byte #0,#0
        .byte #%00000000;$1E
        .byte #%00000000;$1E
        .byte #%00101010;$1E
        .byte #%01110111;$1E
        .byte #%01011101;$1E
        .byte #%00011100;$1E
        .byte #%00001000;$1E

	.byte #0,#0
        .byte #%00000000;$1E
        .byte #%00001000;$1E
        .byte #%00111110;$1E
        .byte #%01111111;$1E
        .byte #%01011101;$1E
        .byte #%00010100;$1E
        .byte #%00001000;$1E

	.byte #0,#0
        .byte #%00001000;$1E
        .byte #%00010100;$1E
        .byte #%00110110;$1E
        .byte #%01111111;$1E
        .byte #%01011101;$1E
        .byte #%00011100;$1E
        .byte #%00001000;$1E

FrameR0
	.byte #0,#0
        .byte #%00011100;$1E
        .byte #%00111000;$1E
        .byte #%00111110;$1E
        .byte #%00111001;$1E
        .byte #%00110010;$1E
        .byte #%00111000;$1E
        .byte #%00011100;$1E
        
	.byte #0,#0
        .byte #%00011100;$1E
        .byte #%00111000;$1E
        .byte #%00111110;$1E
        .byte #%00111111;$1E
        .byte #%00111110;$1E
        .byte #%00111000;$1E
        .byte #%00011100;$1E
        
        .byte #0,#0
	 .byte #%00011100;$1E
        .byte #%00111000;$1E
        .byte #%00111110;$1E
        .byte #%01111001;$1E
        .byte #%00110010;$1E
        .byte #%00111000;$1E
        .byte #%00011100;$1E

	.byte #0,#0
        .byte #%00011100;$1E
        .byte #%00111000;$1E
        .byte #%01111110;$1E
        .byte #%10011111;$1E
        .byte #%01111110;$1E
        .byte #%00111000;$1E
        .byte #%00011100;$1E
        
FrameD0

	.byte #0,#0
        .byte #%00001000;$1E
        .byte #%00011100;$1E
        .byte #%01010101;$1E
        .byte #%01110111;$1E
        .byte #%00111110;$1E
        .byte #%00000000;$1E
        .byte #%00000000;$1E

	.byte #0,#0
        .byte #%00001000;$1E
        .byte #%00011100;$1E
        .byte #%01011101;$1E
        .byte #%01111111;$1E
        .byte #%00111110;$1E
        .byte #%00000000;$1E
        .byte #%00000000;$1E

	.byte #0,#0
        .byte #%00001000;$1E
        .byte #%00011100;$1E
        .byte #%01010101;$1E
        .byte #%01110111;$1E
        .byte #%00111110;$1E
        .byte #%00001000;$1E
        .byte #%00000000;$1E

	.byte #0,#0
        .byte #%00001000;$1E
        .byte #%00011100;$1E
