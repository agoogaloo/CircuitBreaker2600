	processor 6502
        include "vcs.h"
        include "macro.h"
        include "xmacro.h"


;;;; [TODO] ;;;;;
; shmoovement
; [X]	fractional position?	
; [ ]	friction
; [X]	boosting/energy
;
; [X] collision resolution
;
; game logic
; [X]	laps counter/detection
; [ ]	timer

;title/different maps/modes?
;;;;;;;;;;;;;;;;;

SpriteHeight	equ 9
AnimOffset	equ 9
EndAnim		equ 12
EndBoostAnim	equ 30
LapsHeight	equ 192 - 10

NormAccel	equ 15
BoostAccel	equ 32

MaxEnergy	equ 175

RaceStateIdx	equ 0
CountStateIdx	equ 1
P1WinStateIdx	equ 2
P2WinStateIdx	equ 3
MenuStateIdx	equ 4


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Variables segment

        seg.u Variables
	org $80
        
; game state
; 0-> racing
; 1-> countdown
; 2-> p1 win
; 3-> p2 win
; 4-> Game Select
State		.byte
Timer		.word


; movement
P1PrevPos	.word
P2PrevPos	.word

P1PosX		.byte
P1PosY		.byte
P2PosX		.byte
P2PosY		.byte

; fractional position for fixed point
P1PosFX		.byte
P1PosFY		.byte
P2PosFX		.byte
P2PosFY		.byte

P1VelX		.byte
P1VelY		.byte
P2VelX		.byte
P2VelY		.byte

; fractional velocity for fixed point
P1VelFX		.byte
P1VelFY		.byte
P2VelFX		.byte
P2VelFY		.byte

; energy counter. should be 2 bytes apprt for easier addressing
P1Energy	.byte
Temp		.byte	; used for various things
P2Energy	.byte

; sprite/animation
P1AnimOffset	.byte	; offset of the animation from the start of the animation page
P1FrameOffset	.byte 	; total offset of the current frame (animOffset + frame offset)
P2AnimOffset	.byte
P2FrameOffset	.byte


P1AnimFrame	.byte	; frame with respect to the animation start (offset * frameNum)
PFCounter	.byte	; why did I decide to space players apart by 2 bytes...
P2AnimFrame	.byte

; laps
P1Laps		.byte
P1LapLoc	.byte	
P2Laps		.byte
P2LapLoc	.byte

CrashSound	.byte
BoostSound	.byte

; scoreboard buffer
LapsBuff	.ds 8*2


Temp2		.byte	; the movement code (and maybe other stuff later) needs another random byte
TrackPtr	.word
FinishTop	.byte
FinishBot	.byte

; game mode/settings
GameOptions
MapNum		.byte
StartLaps	.byte
GameMode	.byte
ColourNum	.byte

PrevInput	.byte
MenuSelect	.byte
		



;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Code segment

	seg Code
        org $f000

Start

	CLEAN_START
; init


Reset
; player position/colours
        lda #8
        sta P1PosY
        lda #18
        sta P2PosY
        lda #85
        sta P1PosX
       
        sta P2PosX
        lda #$1F
        sta COLUP0
        lda #$5e
        sta COLUP1
        
; lap counter
        lda #$5
        sta StartLaps
       
         
; sprite frames
        lda #FrameL0-AnimationStart
        sta P1AnimOffset
	sta P2AnimOffset

        sta P1AnimFrame
	sta P2AnimFrame

        
        lda #MaxEnergy
        sta P1Energy
        sta P2Energy
        
; track pointer
	lda #<TrackData0
        sta TrackPtr
        lda #>TrackData0
        sta TrackPtr+1
        jsr LoadTrack
        

        
; vertical delay on p0 so they are both synced to the right scanline        
        lda #1
        sta VDELP0
        lda #MenuStateIdx
        sta State
        
        ; crash sound
        ;lda #8
        ;sta AUDC0
        ;lda #7
        ;sta AUDF0
        
        ; good setting for boost sound effect
        ;lda #2
        ;sta AUDC1
        ;lda #3
        ;sta AUDF1
        
        ; drift sound effect
	;lda #8
        ;sta AUDC1
        ;lda #7
        ;sta AUDF1
        
        
; main loop
NextFrame
	lda SWCHB
        lsr
        bcc Start	; reset?
 
; 1 + 3 lines of VSYNC
	VERTICAL_SYNC
; 37 lines of underscan
	TIMER_SETUP 37
        
        
; update scoreboard bitmaps
	lda P1Laps
        ldx #0
	jsr LapsBitmap
        lda P2Laps
        ldx #8
        jsr LapsBitmap

; update sounds
        lda CrashSound
        beq NoCrashDecr
        dec CrashSound
NoCrashDecr
        lsr
        sta AUDV0
        
        lda BoostSound
        beq NoBoostDecr
        dec BoostSound
NoBoostDecr
        lsr
        lsr
        lsr
        sta AUDV1
        
        
; check state, and update accordingly
        lda State
        beq RaceUpdate
        jsr NonRaceUpdate
        jmp EndUpdate
        

;;;;; -[Race Update]- ;;;;
RaceUpdate

; timer updates
	inc Timer	; global timer
        bne NoTimerCarry
        inc Timer+1
NoTimerCarry
        
; animation!
; could probably be condensed for more ROM space if needed
; this only loops boost anim, not boosting caps frame seperately
	lda Timer	; check if frame is multiple of 4
        and #1		; take 0th bit
        bne P2AnimFrameIncr	; next frame
        lda #AnimOffset	; offset between animation frames
        clc		
        adc P1AnimFrame
        cmp #EndBoostAnim
        bcc P1NoResetAnim
        lda #0
P1NoResetAnim
        sta P1AnimFrame
        jmp DoneAnimIncr 
        
P2AnimFrameIncr
	
	lda #AnimOffset	; offset between animation frames
        clc		
        adc P2AnimFrame
        cmp #EndBoostAnim
        bcc P2NoResetAnim
        lda #0
P2NoResetAnim
        sta P2AnimFrame
DoneAnimIncr

; move X and Y coordinates w/ joystick
; give player in x register
	ldx #0
	jsr MoveJoystick
        ldx #2
        jsr MoveJoystick
        
; set frame offsets  
	lda P1AnimFrame
	clc
        adc P1AnimOffset
        sta P1FrameOffset
        
        lda P2AnimFrame
	clc
        adc P2AnimOffset
        sta P2FrameOffset

; apply velocity/collision
	lda Timer
	ldy #0
	jsr WallCollision
        lda #1
        cmp GameMode
        beq SkipP2Move
        lda Timer
        ldy #2
        jsr WallCollision
SkipP2Move
; finish line triggers
	bit CXP0FB
        bvc NoP1Lap
        ldx #0
        jsr CheckLaps
NoP1Lap

	bit CXP1FB
        bvc NoP2Lap
        ldx #2
        jsr CheckLaps
NoP2Lap

	

	sta CXCLR	; reset collision flags after we finish all collisions

	
EndUpdate     

        
; the next two scanlines
; position the player horizontally
	lda P1PosX	; get X coordinate
        ldx #0		; player 0
        jsr SetHorizPos	; set coarse offset
        lda P2PosX	; get X coordinate
        ldx #1		; player 0
        jsr SetHorizPos	; set coarse offset
        lda #4
        ldx #2		; missile/energy bar pos
        jsr SetHorizPos
        lda #161 - 4
        ldx #3		; missle/energy bar pos
        jsr SetHorizPos
        lda #80
        ldx #4		; missle/energy bar pos
        jsr SetHorizPos
        sta WSYNC	; sync w/ scanline
        sta HMOVE	; apply fine offsets
     
; setup for laps counter
        lda #0
        sta ENAM0
        sta ENAM1
        sta ENABL
        sta PF0
        sta PF1
        sta PF2
        lda #$d0
        sta COLUBK
        ;sta COLUPF
        lda #2
        sta CTRLPF
        

; it's ok if we took an extra scanline because
; the PIA timer will always count 37 lines
; wait for end of underscan
        TIMER_WAIT
        lda #0
        sta VBLANK
	
       
; 192 lines of frame
	ldx #192	; X = 192 scanlines
        ldy #0
        
; drawing kernel
LapsLoop
	
        ;lsr		; double height
        lda LapsBuff,y
        sta PF1
        
        SLEEP 20
        
        lda LapsBuff+8,y
        sta PF1
        
	dex
        txa
        and #1
        bne CopyLapLine
        iny
CopyLapLine
        sta WSYNC
        lda #MenuStateIdx
        cmp State
        bne NoMenuLaps
        bit 0		; delay for 3 cycles so timing on each branch lines up
        cpx #192-16
        bne LapsLoop
        lda #0
        sta PF1 
        lda #3
        sta PFCounter
        jmp EndLapsMenuCheck
        
NoMenuLaps
	nop
        cpx #LapsHeight
        bne LapsLoop
        lda #0
        sta PF1  
        sta PFCounter
EndLapsMenuCheck
 
 	
        dex
        sta WSYNC
        lda #%010001
        sta CTRLPF
        lda #$c3
        sta COLUBK
        lda #$D8
        sta COLUPF 
        dex
        sta WSYNC
       
      
; draw the actual game
FieldLoop

; P1 energy bar
	lda #0		; dont draw
        cpx P1Energy 	; is row < energy ?
        bcs SkipBar1
        ;lda #3
        txa		; draw dashed line
SkipBar1
	sta ENAM0	; update if we draw line

; P2 energy bar
        ;lda #0
	cpx P2Energy	
        bcs SkipBar2
        txa
SkipBar2
	sta ENAM1	; draw missile (for the bar)
        
; draw finish line
	cpx FinishBot
        bcc DrawFinish
        cpx FinishTop
        bcs DrawFinish
        jmp FinishEnd
DrawFinish
	stx ENABL
FinishEnd
	

; draw playfield/map
       	txa		; height on the screen already in a to save 2 cycles
        and #7		
        bne NoFieldIncr	; increment index every 8 pixels
    	lda #3
        clc
	adc PFCounter	; add 3 bytes to go to the next index
	sta PFCounter
        
NoFieldIncr        
        
	ldy PFCounter 	; load current location in the playfield
	lda (TrackPtr),y

        sta WSYNC	; start the next line
        iny
        dex
       	sta PF0		; set byte 0 (loaded before WSYNC
        lda (TrackPtr),y ; load the 2nd byte
        iny
       
        sta PF1		; set the 2nd byte we just loaded
        lda (TrackPtr),y
        sta PF2		; set the 3rd byte        
        

	
DrawP1     
; draw p1
	txa		; X -> A
        sec		; set carry for subtract
        sbc P1PosY	; local coordinate
        lsr
        cmp #SpriteHeight ; in sprite?
        bcc InSprite1	; yes, skip over next
        lda #0		; not in sprite, load 0

InSprite1
	
	;clc		; clear for addition (extra buffer is added instead to save the clock cycles)
        adc P1FrameOffset	; add animation offset
	tay		; local coord + frame -> Y
        lda AnimationStart,y	; lookup frame line
        sta GRP0	; store bitmap
       
; draw p2
	txa 
        sec
        sbc P2PosY
        lsr
        cmp #SpriteHeight
        bcc InSprite2
        lda #0		;use bottom clear row if not in sprite
        
InSprite2
	;clc
        adc P2FrameOffset
	tay
        
SkipP2
        sta WSYNC	; sync w/ scanline
        lda AnimationStart,y
        sta GRP1
        dex		; decrement X
        
        bne FieldLoop	; repeat until 192 lines

; 29 lines of overscan
	TIMER_SETUP 29
        lda #0
        sta ENAM0
        sta ENAM1
        TIMER_WAIT
; total = 262 lines, go to next frame
        jmp NextFrame

;;;;; -[subroutines]- ;;;;;

; update for game select, countdown, win screen, etc.
NonRaceUpdate	subroutine
	cmp #CountStateIdx
        beq .CountDown
        cmp #P1WinStateIdx
        beq .P1Win
        cmp #P2WinStateIdx
        beq .P2Win
        jmp .GameSelect
        ;cmp #MenuStateIdx
       ; beq .GameSelect
        
;;;;; -[Countdown Update]- ;;;;;
.CountDown
        
	inc Timer
        lda #60		
        cmp Timer	; has it been 60 frames?
        bne .Return
        lda #0		; it has been 1 second, reset the timer
        sta Timer
        
        lda #10
        sta AUDC1	; play sound
        lda #3
       	sta AUDF1
        lda #32
        sta BoostSound
        
        dec P1Laps	; subtract form timer
        bne .Return	; there are still a few seconds, keep waiting
        
        lda #1		; higher pitch at the end
       	sta AUDF1
        lda #40
        sta BoostSound
        lda P2Laps	; Timer reached 0, start the race!
        sta P1Laps
	lda #RaceStateIdx
        sta State
        rts
        
;;;;; -[Win Screen Update]- ;;;;;       
.P1Win
	ldy #2
        jmp .BothWinState
.P2Win
	ldy #0
        
.BothWinState
	lda Timer
        and #1
        bne .EndAnim
        lda P2AnimFrame
        clc
        adc #AnimOffset
        sta P2AnimFrame
        cmp #70
        bcs .EndAnim	 ; don't update after max animation frame at 7
        

	lda #ExplosionFrames-AnimationStart	; animation offset for death anim
        clc
        adc P2AnimFrame
        sta P1FrameOffset,y
        jmp .EndAnim
.EndAnim
	lda Timer
        cmp #45
        bne .WinNoTimer	; increment timer if it has been less than 30 frames
	bit INPT4	; reset if either button is pushed
        bpl .WinToMenu
        bit INPT5
        bpl .WinToMenu
        rts		; otherwise, just exit
.WinToMenu
        ; go back to menu/game select
        lda #0		; zero timer for menu selection
        sta Timer
        sta MenuSelect	; reset selection to 0 before entering menu

        lda #MenuStateIdx
        sta State	; switch to menu/settings select
.WinNoTimer
	inc Timer	; increment timer
        
        and #7		; mod 8
        bne .Return
        
        lda Timer
        lsr		; temp = Timer/4
        lsr
        lsr
        sta Temp
        
        lda #8
        ;sec
        sbc Temp
        sta AUDF1
        lda #10
        sta AUDC1
        lda #50
        sta BoostSound
        
.Return
	rts  
;;;;; -[Game Mode Select]- ;;;;;
.GameSelect 
	; update lap counter with the current mode
	lda P1Laps
        ldx #0
	jsr MenuBitmap
        
        lda #FrameU0-AnimationStart
        sta P1FrameOffset
	sta P2FrameOffset

      
        
        lda #45
        cmp Timer		; wait 45 frames before checking if button is pressed
        bcc .CheckStart
        inc Timer		; hasn't been long enough, just do menu movement
        jmp .MenuInput 	
.CheckStart

	bit INPT4		; start game if either button is pushed
        bpl .StartGame
        bit INPT5
        bpl .StartGame
        jmp .MenuInput		; do menu selection with joystick
.StartGame
	
        
	lda #0
        sta Timer		; reset timer
        sta Timer+1
        
        sta P1VelX		; reset velocities
        sta P1VelY
	sta P1VelFX
        sta P1VelFY
        sta P2VelX
        sta P2VelY
	sta P2VelFX
        sta P2VelFY
        
	lda #MaxEnergy		; reset energy
        sta P1Energy
        sta P2Energy
        
	lda #1			;make P2 invisible in game mode 1
        cmp GameMode
        bne .P2Visible
        lda #$D8
        sta COLUP1
.P2Visible
        
        lda #2
        sta P1Laps		; starting countdown
        lda StartLaps
        sta P2Laps		; move lap counter to the actual laps
        lda #CountStateIdx	; switch to countdown to start the race
        sta State		; (this input shuold probably be changed)
        sta CXCLR		; clear collision flags so things don't break
        rts

.MenuInput
	; menu selection
        ; 0-> track
        ; 1-> lap count
        ; 2-> game mode
        ; 3-> Colours
        lda MenuSelect	; get current menu selection
        sta P1Laps	; show in P1laps
        tay
        lda GameOptions,y
        sta P2Laps	; update setting value
        jsr ModePosReset	; update starting positions
      
        
        lda SWCHA	; get Input Map
        lsr
        lsr		; combine player 1 and 2 inputs to the same lower 4 bits
        lsr
        lsr
        and SWCHA
        cmp PrevInput	; only do stuff on button press
        beq .Return  
        sta PrevInput
        
        lda #12
        sta AUDC0
        lda #7
       	sta AUDF0
       
       
        ; parse inputs
        ; up/down to change menu seletion (map, mode, laps, etc.)
        lda #1
        bit PrevInput		; up pressed?
        bne .NoUp
        inc MenuSelect
        lda #10
        sta CrashSound
.NoUp
        lda #2
        bit PrevInput
        bne .NoDown		; Down pressed
        dec MenuSelect
        lda #10
        sta CrashSound
.NoDown

	lda #3
        and MenuSelect		; only take lower 2 bits for menu selection
        sta MenuSelect
        tay
        lda GameOptions,y	; load current value of the option
        sta P2Laps		; show value in P2Laps
	
       

	; parse inputs
        lda #4
        bit PrevInput		; Left pressed?
        bne .NoLeft
        dec P2Laps
        lda #10
        sta CrashSound
.NoLeft
        lda #8
        bit PrevInput
        bne .NoRight	; Right pressed
        inc P2Laps
        lda #10
        sta CrashSound
.NoRight
      	ldx MenuRanges,y		; load max value for selection
        lda #$FF
       	cmp P2Laps
       	bne .NoDownLoop
       	stx P2Laps
        
.NoDownLoop
	;inx
	cpx P2Laps
        bcs .NoUpLoop
        lda #0
        sta P2Laps
.NoUpLoop
       
       ; update params based on menu selection and value
	lda #0
        cmp MenuSelect
        bne .NoTrack	; track select
       	jsr MenuTrackSave
        rts  
.NoTrack

       	lda #1
       	cmp MenuSelect	; laps select
        bne .NoLaps
        jsr MenuLapsSave
  
        rts
        
        
.NoLaps	
 
       	lda #2
       	cmp MenuSelect	; game mode select
        bne .NoMode
        lda P2Laps
        sta GameMode
        
        rts
        
        
.NoMode	
	; otherwise its just colour select
       	jsr MenuColourSave
        rts
        
 
 
MenuTrackSave 	subroutine
	lda P2Laps
        sta MapNum
        bne .Not0	; is track 0 selected?
        lda #<TrackData0
        sta TrackPtr	; load track 0
        lda #>TrackData0
        sta TrackPtr+1
        jsr LoadTrack
        rts		; return
.Not0
	cmp #1
        bne .Not1	; is track 1 selected?
        lda #<TrackData1
        sta TrackPtr	; load track 1
        lda #>TrackData1
        sta TrackPtr+1
	jsr LoadTrack
        rts
.Not1
	cmp #2
        bne .Not2	; is track 2 selected?
        lda #<TrackData2
        sta TrackPtr	; load track 2
        lda #>TrackData2
        sta TrackPtr+1
	jsr LoadTrack
        rts

.Not2
	cmp #3
        bne .Not3	; is track 2 selected?
        lda #<TrackData3
        sta TrackPtr	; load track 2
        lda #>TrackData3
        sta TrackPtr+1
	jsr LoadTrack
        rts

.Not3
	cmp #4
        bne .Not4	; is track 2 selected?
        lda #<TrackData4
        sta TrackPtr	; load track 2
        lda #>TrackData4
        sta TrackPtr+1
	jsr LoadTrack
        rts

.Not4
	cmp #5
        bne .Not4	; is track 2 selected?
        lda #<TrackData5
        sta TrackPtr	; load track 2
        lda #>TrackData5
        sta TrackPtr+1
	jsr LoadTrack
        rts

.Not5
        rts

MenuLapsSave	subroutine
	lda P2Laps
      	and #$0f	; take last digit
        cmp #$a
        bne .NotA
        lda P2Laps	; add 5 to become decimal
        adc #5		; carry will be clear because compare was equal
        sta StartLaps
        sta P2Laps
        rts
.NotA
	cmp #$f		; check if it ends in f
        bne .NotF
        lda P2Laps	; counter was decremented, subtract 5
        sbc #6		; carry will be clear from equals comparison
        sta StartLaps
        sta P2Laps
        rts
.NotF
	lda P2Laps
	sta StartLaps
        rts
        

ModePosReset	subroutine
	ldy #(3*23)+2	; offset total bytes of level data to find starting position heights
        lda (TrackPtr),y
        sta P1PosY	; store bottom height in P1Pos
        iny
        lda (TrackPtr),y
        sta P2PosY	; store top height in P2Pos
        
	lda GameMode
        cmp #0
        beq .Mode0
        cmp #1
        beq .Mode1
        cmp #2
        beq .Mode2
; standard race mode
.Mode0
	clc
	lda #6
        adc P1PosY
        sta P2PosY
        lda #-6
        adc P1PosY
        sta P1PosY
        
        lda #85
        sta P1PosX
        sta P2PosX
        lda #0		; P2 starts on bottom 
        sta P2LapLoc
	lda #FrameL0-AnimationStart
        sta P2AnimOffset
        sta P1AnimOffset
	rts
        
; single player time trial
.Mode1
	; P1Y is already in correct spot
        lda #85
        sta P1PosX
        lda #0
        sta P2PosX
        sta P2PosY
        sta P2PrevPos
        sta P2PrevPos+1
        lda #FrameL0-AnimationStart
        sta P1AnimOffset
	rts
        
; special laps mode
.Mode2
	; y positions are already lloaded from level
        lda #85
        sta P1PosX
        lda #67
        sta P2PosX
        lda #1		; P2 starts on the top in this mode 
        sta P2LapLoc
        lda #FrameR0-AnimationStart	; both players face opposite directions
        sta P2AnimOffset
        lda #FrameL0-AnimationStart
        sta P1AnimOffset
        rts
        
; update and save colours
MenuColourSave	subroutine
	lda P2Laps
        sta ColourNum
        asl
        asl		; multiply by 8
        asl
        ;asl
        tax		; save to use with P2
        adc #$1F	; add offset to base colour
        sta COLUP0
        txa
        
        adc #$5F	; add offset to base colour
        sta COLUP1

        
	rts

; Initilizes rest of track based on trackPtr
LoadTrack	subroutine
 	ldy #(3*23)	; offset total bytes of level data to find finish line heights
        lda (TrackPtr),y
        sta FinishTop
        iny
        lda (TrackPtr),y
        sta FinishBot
        rts
        
; update laps when lap line is hit
; preconditions: 
; x-> playerNum (0/2)
CheckLaps	subroutine
	lda P1PosY,x	; get y position
        cmp FinishBot	; check bottom line
        bcc .BotLine	; below 
       	lda P1LapLoc,x	
        
        beq .Return	; last touch was also on top, don't count 
	jsr SubtractLap	; completed a 1/2 lap, subtract from the remaining laps
        
        
        lda P1Laps,x		; load remaining laps again for check 
        beq .WinGame	; win if there are no laps left
	lda #0		
        sta P1LapLoc,x
        rts
.BotLine
	lda P1LapLoc,x	
        bne .Return	; last touch was also on top, don't count 
        jsr SubtractLap
        
        lda P1Laps,x		; load remaining laps again for check 
        beq .WinGame

        		
	lda #1		; store 1 to indicate side we touched
        sta P1LapLoc,x
.Return
	rts
; transition to win state
.WinGame
	txa
        lsr		; convert to 2/3 for player 1/2 win
        ora #2
        sta State	; win state!
        lda Timer+1	; record time
        sta P1Laps
        lda Timer
        sta P2Laps
        lda #0
        sta Timer	; reset timer
        sta Timer+1
        sta P1AnimFrame
        sta P2AnimFrame
	rts
        
        
SubtractLap	subroutine
	sed		;set decimal mode for changing laps
        lda P1Laps,x	; decrement lap counter
        sec
        sbc #1
        sta P1Laps,x
        
        ; increment other player laps in game mode 2
        lda #2
        cmp GameMode
        bne .NormMode	; skip if not mode 2
        txa
        eor #2			; flip bit to get other player offset
        tax
        lda P1Laps,x
        ;sec 			; carry will always be set because last subtract shouldnt overflow
        adc #0			; subtract 1
        sta P1Laps,x 
        txa
        eor #2			; flip bit back
        tax
        
.NormMode
	cld
	rts
        
; preconditions: 
; a-> frame counter (x or y collision)
; on even, move x, check y for collision from last frame
; y-> playerNum (0/2) 
WallCollision	subroutine       
	and #1		; take last bit of frame#
        sty Temp
        clc		; add a and y to get offset of data
        adc Temp
        tay		; y now has offset of the axis we are resolving

; move position based on velocity      
        clc		; clear carry for addition
        lda P1VelFX,y	
        adc P1PosFX,y	; add fractional parts 
        sta P1PosFX,y
        
        lda P1PosX,y	; add whole number parts with carry from fraction
        sta P1PrevPos,y	;store initial position in case of collision
        adc P1VelX,y
        sta P1PosX,y

        
; player/wall collision
; this operates on the axis fom last frame, not this frame
        cpy #2		; compare player num in y
        bcs .P2Reg	; check player number
        bit CXP0FB	; get sprite/wall collision
        bpl .NoWall	; no collision
        jmp .RestoreVal	; restore movement from previous frame
.P2Reg
	bit CXP1FB
        bpl .NoWall
        
.RestoreVal
	tya
        eor #1		; flip x/y bit because we are checking collision from last frame
        tay
        
        lda #0
        sta P1VelX,y	; stop velocity
        sta P1VelFX,y
       
        lda P1PrevPos,y	; reset position 
        sta P1PosX,y
        ; play sound
        lda #8
        sta AUDC0	; set audio setting to crash sound
        lda #7
        sta AUDF0
        lda #8
        sta CrashSound
        
        
       
.NoWall
	rts
        
        


; pre conditions: x=offset into array ,a=BCD number
LapsBitmap	subroutine
	
	pha 		; push a for later
        and #$0f 	; mask out 1st digit
; multiply by 5 to get location of bitmap
        sta Temp
        asl
        asl
        adc Temp
        tay		; store in y
        lda #5		
        sta Temp	; loop through each row
.digit1
	lda DigitsBitmap,y
        and #$0f	; get 1st digit
        sta LapsBuff,x	; store it
        inx
        iny		;update counters
        dec Temp
       	bne .digit1
; 2nd digit        
        pla		; restore original value
        lsr
        lsr
        lsr
        lsr
        sta Temp	; store 2nd digit * 4
        asl
        asl
        adc Temp	
        tay		; digit* 5 (bitmap offset) is in y
        dex
        dex		; restore x back to original value
        dex
        dex
        dex
        lda #5
        sta Temp
.digit2
	lda DigitsBitmap,y
        and #$F0	; take left digit
	ora LapsBuff,x	; combine with 1st digit
        sta LapsBuff,x	; store back
        inx
        iny		; update counters
        dec Temp
        bne .digit2
        
	rts


MenuBitmap	subroutine
	lda MenuSelect
        clc
        adc #1
        asl
        asl	;multiply by 8
        asl
       	tay
        ldx #0
        
.loop
	dey
        lda ModesBitmap,y
        sta LapsBuff,x
       
        inx
        cpx #8
        bne .loop
	rts

; SetHorizPos routine
; A = X coordinate
; X = player number (0 or 1)
	
SetHorizPos	subroutine
	sta WSYNC	; start a new line
        bit 0		; waste 3 cycles
	sec		; set carry flag
DivideLoop
	sbc #15		; subtract 15
	bcs DivideLoop	; branch until negative
	eor #$7		; calculate fine offset
	asl
	asl
	asl
	asl
	sta RESP0,x	; fix coarse position
        ;lda #$80
	sta HMP0,x	; set fine offset
	rts		; return to caller

; Read joystick movement/boost and apply to 
; x is 0 for p1, 2 for p2
; this could be split by axis per frame like movement if more time is needed
; (could also just stop useing indirect addressing for everythihg)
MoveJoystick	subroutine

; Find which axis has larger motion
; this whole thing basically just does if(abs(x)>abs(y))
; take absolute value for yvelocity
        lda P1VelY,x
        bpl .PositiveY	; y velocity is already positive
        lda #$ff
        sec
        sbc P1VelY,x	; 0 - P1Vel
        sta Temp	; store in Temp
        lda #0
        sec 
        sbc P1VelFY,x 	; apply to fractional component too
        sta Temp2 
        jmp .DoneAbsY
.PositiveY
	sta Temp
        lda P1VelFY,x
        sta Temp2
.DoneAbsY

; absolute val for X velocity
        lda P1VelX,x
        bpl .PositiveX	; y velocity is already positive
        lda #$0
        sec
        sbc P1VelFX,x	; 0 - P1Vel
        tay		; store in y register
        lda #$ff		; do whole component last so it ends in a register
        sec 
        sbc P1VelX,x 	; apply to fractional component too
        ;sta Temp2 
        jmp .DoneAbsX
.PositiveX
        lda P1VelFX,x
        tay
        lda P1VelX,x
.DoneAbsX
; now Temp = abs(velY) whole, Temp2 = abs(velY) fraction
; a = abs(velX) whole, y = abs(velX) fraction
        
        cmp Temp	; compare whole components
        bcc .BigYVel	; whole compoent of y is bigger
        bne .BigXVel	; not equal -> whole of X is bigger
        cmp #0		; if x and y velocities are less than 1, just ignore
        beq .DoneVelCheck
        tya		
        cmp Temp2	; whole compoent was equal -> check fractions
        bcc .BigYVel	; fraction of y is bigger
        bne .BigXVel	; not equal -> fraction of X is bigger
        lda #0
        jmp .DoneVelCheck
.BigYVel
	lda #$80
        jmp .DoneVelCheck
.BigXVel
	lda #$40
.DoneVelCheck
	; 100..0 = y bigger, 01..00 = x bigger
	sta Temp2 ; store indicator in Temp2
        ;sta P1Laps,x



        
; boost input
; stores the speed in Temp
	txa 		; check player number
        bne P2Boost	
        bit INPT4	; check p1 boost input
        bpl .boost
        jmp .NoBoost
P2Boost
	bit INPT5	; check p2 boost input
        bpl .boost
        jmp .NoBoost
	
.boost  		; do the boost
	lda P1Energy,x
        sec
	sbc #2		; consume 2 boost meter
        bcc .NoBoost	; don't boost if you don't have enought energy
        sta P1Energy,x
	lda #BoostAccel ; store acceleration in Temp
        sta Temp
        ; do sound effect
        lda #2
        sta AUDC1	; track settings
        lda #3
        sta AUDF1
        
        lda #20
        cmp BoostSound	; only refresh sound when its below 20 frames
        bcc .SkipSound
        lda #26
        sta BoostSound
.SkipSound

        jmp .EndBoost

.NoBoost		; don't boost
	lda #NormAccel ; store normal acceleration
        sta Temp
        		 
        lda #EndAnim	; only do the 1st 2 frames of animation
        cmp P1AnimFrame,x	
        bcs .NoAnimReset; don't need to reset
        lda #0		; go back to frame 1
        sta P1AnimFrame,x
.NoAnimReset
.EndBoost



       
; modify velocity from inputs       
; y axis:
	ldy P1VelFY,x	; store fractional yVel in y register
        txa
        bne .P2Down	; use p2 bitmask/velocity
        lda #%00100000	; else, use p1 bitmask        
        jmp .DownDone
.P2Down
	lda #%00000010	
.DownDone
	bit SWCHA	; pressed?
	bne .SkipMoveDown	; if not, skip moving down
     
            ; set frame
        lda #FrameD0-AnimationStart
        sta P1AnimOffset,x
        
        ; subtract Temp from fractional velocity
        tya
        sec
        sbc Temp
        tay
        bcs .SkipMoveDown
        dec P1VelY,x	; apply to whole velocity if it overflowed
      
        
.SkipMoveDown

; check up direction
	txa
        bne .P2Up
        lda #%00010000	;Up
        jmp .UpDone
.P2Up
	lda #%00000001	;Up on p2 controller
.UpDone
	bit SWCHA 
	bne .SkipMoveUp
        
             ; set frame
        lda #FrameU0-AnimationStart
        sta P1AnimOffset,x
        
       	; add Temp to fractional velocity
        tya
        clc
        adc Temp
        tay
        bcc .SkipMoveUp
        inc P1VelY,x
        
.SkipMoveUp
	
	tya
	cmp P1VelFY,x
        beq .NoChangeY	; check if we acually moved in y axis
	sta P1VelFY,x	; update value
        
; check for drift
        bit Temp2	; check priamry velocity direction
        bvc .NoChangeY	; 
        lda #MaxEnergy
     	cmp P1Energy,x
        bcc .NoChangeY
        
        jsr InDrift
        
.NoChangeY   
        

; horizontal velocity
	ldy P1VelFX,x
; check left
        txa
        bne .P2Left
        lda #%01000000
        jmp .LeftDone
.P2Left
	lda #%00000100
.LeftDone
; Move horizontally
	bit SWCHA
	bne .SkipMoveLeft
; set frame
             ; set frame
        lda #FrameL0-AnimationStart
        sta P1AnimOffset,x
; subtract
	tya
        sec
        sbc Temp
        tay
        bcs .SkipMoveLeft
        dec P1VelX,x
       	
.SkipMoveLeft

; get right input
	txa
        bne .P2Right
        lda #%10000000		
        jmp .RightDone
.P2Right
	lda #%00001000		;Right?
.RightDone	
	bit SWCHA 
	bne .SkipMoveRight
        
        ; set frame
        lda #FrameR0-AnimationStart
        sta P1AnimOffset,x
        
; add to fractional velocity
        tya
        clc
        adc Temp
        tay
        bcc .SkipMoveRight
        inc P1VelX,x
        
.SkipMoveRight
	tya
	cmp P1VelFX,x
        beq .NoChangeX	; check if we acually moved in y axis
	sta P1VelFX,x	; update value
        
; check for drift
        bit Temp2	; check priamry velocity direction
        bpl .NoChangeX	; 
        lda #MaxEnergy
     	cmp P1Energy,x
        bcc .NoChangeX
        
        jsr InDrift
.NoChangeX
	rts
        
InDrift	subroutine
	inc P1Energy,x	; add energy if velocity is in x axis
        ; drift sound effect
        
	lda #2
        sta AUDC0
        lda #15
        sta AUDF0
        lda #4
        sta CrashSound
	rts

; preconditions:
; Temp2 = #$FF
; a = Value to get abs
; negative flag set correctly
AbsVal	subroutine
	; Find which axis has larger motion
        bpl .PositiveY	; y velocity is already positive
        eor Temp2
        clc
        adc #1
        lda #0
        sec		; 0 - yVel to get the absolute value		
        sbc P1VelY,x
.PositiveY
        rts
        
        
