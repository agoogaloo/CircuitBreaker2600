
	processor 6502
        include "vcs.h"
        include "macro.h"
        include "xmacro.h"

;;;; [TODO] ;;;;;
; map/backgound (with compression probably)
; fix sprite drawing
; shmoovement 
;	signed velocity
;	friction
;	boosting/energy
;
; collision resolution
;	split x/y axis
;
; game logic
;	laps counter/detection
;	timer

;title/different maps/modes?
;;;;;;;;;;;;;;;;;

SpriteHeight	equ 14 
LapsHeight	equ 192 - 10


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Variables segment

        seg.u Variables
	org $80

MvTimer		.byte
P1XPos		.byte
P2XPos		.byte
P1YPos		.byte
P2YPos		.byte
P1FramePtr	.word
P2FramePtr	.word
P1Anim		.byte
P2Anim		.byte
P1Energy	.byte
P2Energy	.byte


P1Laps		.byte
P2Laps		.byte
LapsBuff	.ds 10
Temp		.byte

TrackPtr	.word
PFIdx		.byte
PFCounter	.byte



;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Code segment

	seg Code
        org $f000

Start
	CLEAN_START
; init
; player position/colours
        lda #80
        sta P1YPos
        sta P2YPos
        lda #50
        sta P1XPos
        lda #100
        sta P2XPos
        lda #$1F
        sta COLUP0
        lda #$2F
        sta COLUP1
        
        
        lda #$60
        sta P1Laps
        lda #$06
        sta P2Laps
         
; sprite frames
        lda #<FrameU0
        sta P1FramePtr
	sta P2FramePtr
        lda #>FrameU0
        sta P1FramePtr+1
        sta P2FramePtr+1
        
        lda #50
        sta P1Energy
        lda #50
        sta P2Energy
; track pointer
	lda #<TrackData
        sta TrackPtr
        lda #>TrackData
        sta TrackPtr+1
        
; vertical delay on p0 so they are both synced to the right scanline        
        lda #1
        sta VDELP0
        
; main loop
NextFrame
        lsr SWCHB	; test Game Reset switch
        bcc Start	; reset?
; 1 + 3 lines of VSYNC
	VERTICAL_SYNC
; 37 lines of underscan
	TIMER_SETUP 37
        
; move X and Y coordinates w/ joystick
; give player in y register
	ldy #0
	jsr MoveJoystick
        ldy #1
        jsr MoveJoystick
; detect player collision
	bit CXPPMM
        bpl NoCollision
        inc P1XPos
        dec P2XPos
        sta CXCLR
NoCollision
        
; animation!
	ldx #0		; p1 frame 0
        ldy #0		; p1 frame 0
	inc MvTimer
	lda MvTimer	; check if frame is multiple of 4
        and #4
        beq Frame0Anim		;switch frames
        ldx #SpriteHeight 	; next frame
        ldy #SpriteHeight	; next frame
Frame0Anim
	stx P1Anim
        sty P2Anim
        
; update scoreboard bitmaps
	lda P1Laps
        ldx #0
	jsr LapsBitmap
        lda P2Laps
        ldx #5
        jsr LapsBitmap
        
; the next two scanlines
; position the player horizontally
	lda P1XPos	; get X coordinate
        ldx #0		; player 0
        jsr SetHorizPos	; set coarse offset
        lda P2XPos	; get X coordinate
        ldx #1		; player 0
        jsr SetHorizPos	; set coarse offset
        lda #5
        ldx #2		;missle/energe bar pos
        jsr SetHorizPos
        lda #8
        ldx #3		;missle/energe bar pos
        jsr SetHorizPos
        sta WSYNC	; sync w/ scanline
        sta HMOVE	; apply fine offsets
        
; setup for laps counter
        lda #0
        sta ENAM0
        sta ENAM1
        sta PF0
        sta PF1
        sta PF2
        lda #$18
        ;sta COLUBK
        ;sta COLUPF
        lda #2
        sta CTRLPF
        
; it's ok if we took an extra scanline because
; the PIA timer will always count 37 lines
; wait for end of underscan
        TIMER_WAIT
        lda #0
        sta VBLANK
	
       
; 192 lines of frame
	ldx #192	; X = 192 scanlines
        ldy 0
        
; drawing kernel
LapsLoop
	
        ;lsr		; double height
        lda LapsBuff,y
        sta PF1
        
        SLEEP 28
        
        lda LapsBuff+5,y
        sta PF1
        
	dex
        txa
        and #1
        bne CopyLapLine
        iny
CopyLapLine
        
        sta WSYNC
        cpx #LapsHeight
        bne LapsLoop
 
 	lda #0
        sta PF1  
        sta PFCounter
        dex
        sta WSYNC
        lda #$01
        sta CTRLPF
        lda #$c3
        sta COLUBK
        lda #$16
        sta COLUPF 
        dex
        sta WSYNC
       
      

; draw the actual game
FieldLoop

; P1 energy bar
	lda #0		; dont draw
        cpx P1Energy 	; is row < energy ?
        bcs SkipBar1
        ;lda #3
        txa		; draw dashed line
SkipBar1
	sta ENAM0	; update if we draw line

; P2 energy bar
        lda #0
	cpx P2Energy	
        bcs SkipBar2
        txa
SkipBar2
	sta ENAM1	; draw missile (for the bar)

; draw playfield/map
       	txa		; height on the screen
        and #7		
        bne NoFieldIncr	; increment index every 8 pixels
    	lda #3
        clc
	adc PFCounter	; add 3 bytes to go to the next index
	sta PFCounter
        
NoFieldIncr
	
	ldy PFCounter 	; load current location in the playfield
	lda (TrackPtr),y
        pha		; put byte 0 onto the stack
        iny
      	lda (TrackPtr),y ; load the 2nd byte
        iny
        
        sta WSYNC	; start the next line
        dex
       
        sta PF1		; set the 2nd byte we just loaded
        lda (TrackPtr),y
        sta PF2		; set the 3rd byte
        pla 
        sta PF0		; set byte 0 from the stack
        
; draw finish line
	stx ENABL

	
DrawP1     
; draw p1
	txa		; X -> A
        sec		; set carry for subtract
        sbc P1YPos	; local coordinate
        lsr
        cmp #SpriteHeight ; in sprite?
        bcc InSprite1	; yes, skip over next
        lda #0		; not in sprite, load 0

InSprite1
	
	;clc		; clear for addition (extra buffer is added instead to save the clock cycles)
        adc P1Anim	; add animation offset
        
	tay		; local coord + frame -> Y
        lda (P1FramePtr),y	; lookup frame line
       
        sta GRP0	; store bitmap
       
; draw p2
	txa 
        sec
        sbc P2YPos
        lsr
        cmp #SpriteHeight
        bcc InSprite2
        lda #0		;use bottom clear row if not in sprite
        
InSprite2
	;clc
        adc P2Anim
	tay
        
SkipP2
        sta WSYNC	; sync w/ scanline
        lda (P2FramePtr),y
        sta GRP1
        dex		; decrement X
        
        bne FieldLoop	; repeat until 192 lines

; 29 lines of overscan
	TIMER_SETUP 29
        TIMER_WAIT
; total = 262 lines, go to next frame
        jmp NextFrame


; pre conditions: x=offset into array ,a=BCD number
LapsBitmap	subroutine
	
	pha 		; push a for later
        and #$0f 	; mask out 1st digit
; multipluy by 5 to get location of bitmap
        sta Temp
        asl
        asl
        adc Temp
        tay		; store in y
        lda #5		
        sta Temp	; loop through each row
.digit1
	lda DigitsBitmap,y
        and #$0f	; get 1st digit
        sta LapsBuff,x	; store it
        inx
        iny		;update counters
        dec Temp
       	bne .digit1
; 2nd digit        
        pla		; restore original value
        lsr
        lsr
        lsr
        lsr
        sta Temp	; store 2nd digit * 4
        asl
        asl
        adc Temp	
        tay		; digit* 5 (bitmap offset) is in y
        dex
        dex		; restore x back to original value
        dex
        dex
        dex
        lda #5
        sta Temp
.digit2
	lda DigitsBitmap,y
        and #$F0	; take left digit
	ora LapsBuff,x	; combine with 1st digit
        sta LapsBuff,x	; store back
        inx
        iny		; update counters
        dec Temp
        bne .digit2
        
	rts

; SetHorizPos routine
; A = X coordinate
; X = player number (0 or 1)
SetHorizPos	subroutine
	sta WSYNC	; start a new line
        bit 0		; waste 3 cycles
	sec		; set carry flag
DivideLoop
	sbc #15		; subtract 15
	bcs DivideLoop	; branch until negative
	eor #$7		; calculate fine offset
	asl
	asl
	asl
	asl
	sta RESP0,x	; fix coarse position
        ;lda #$80
	sta HMP0,x	; set fine offset
	rts		; return to caller


; Read joystick movement and apply to object 0
; y is 0 for p1, 1 for p2
MoveJoystick subroutine
; Move vertically
; (up and down are actually reversed since ypos starts at bottom)
	ldx P1YPos,y
        tya
        bne .P2Down
        lda #%00100000	;Up?
        jmp .DownDone
.P2Down
	lda #%00000010	;Up?
.DownDone
	bit SWCHA
	bne .SkipMoveDown
     
     	tya 	; addresses are 2 bytes, so offset needs to be doubled
        asl
        tay
       	lda #<FrameD0
        sta P1FramePtr,y
        lda #>FrameD0 
        sta P1FramePtr+1,y
        tya 	; addresses are 2 bytes, so offset needs to be doubled
        lsr
        tay
        
 
        ; stop on edges
        cpx #15
        bcc .SkipMoveDown
        dex
        dec P1Energy
        inc P2Energy
.SkipMoveDown
; check up direction
	tya
        bne .P2Up
        lda #%00010000	;Up?
        jmp .UpDone
.P2Up
	lda #%00000001	;Up on p2 controller?
.UpDone
	bit SWCHA 
	bne .SkipMoveUp
        
        tya
        asl		; multiply by 2 bytes
        tay
        lda #<FrameU0
        sta P1FramePtr,y
        lda #>FrameU0 
        sta P1FramePtr+1,y
        
        tya
        lsr		; divide by 2 so it normal again
        tay
        
        cpx #183
        bcs .SkipMoveUp
        inx
.SkipMoveUp
	stx P1YPos,y
        tya
        bne .P2Left
        lda #%01000000
        jmp .LeftDone
.P2Left
	lda #%00000100
.LeftDone
; Move horizontally
        ldx P1XPos,y
	bit SWCHA
	bne .SkipMoveLeft
        ; set frame
        tya 		; addresses are 2 bytes, so offset needs to be doubled
        asl
        tay
        lda #<FrameL0
        sta P1FramePtr,y
        lda #>FrameL0 
        sta P1FramePtr+1,y
        tya
        lsr
        tay
        
        cpx #1
        bcc .SkipMoveLeft
        dex
.SkipMoveLeft
	tya
        bne .P2Right
        lda #%10000000		;Right?
        jmp .RightDone
.P2Right
	lda #%00001000		;Right?
.RightDone	
	bit SWCHA 
	bne .SkipMoveRight
        
        ; set frame
        tya
        asl
        tay
        lda #<FrameR0
        sta P1FramePtr,y
        lda #>FrameR0 
        sta P1FramePtr+1,y
        tya
        lsr
        tay
        ; cap on edges
        cpx #153
        bcs .SkipMoveRight
        inx
.SkipMoveRight
	stx P1XPos,y
	rts


        
        align #$100
        
TrackData
        .byte #%11110000, #%11111111,#%11111111
        .byte #%00010000, #%00000000,#%11110000
        .byte #%00110000, #%00000000,#%00001110
        .byte #%00010000, #%00000001,#%00000001
        .byte #%00110000, #%00000010,#%00000000
        .byte #%10110000, #%10000000,#%00000000
        .byte #%00110000, #%00000000,#%00000000
        .byte #%11110000, #%11111111,#%11111111

	;.byte $FF,$FF,$FF,
        ;.byte $FF,$FF,$FF,
       ; .byte $30,$00,$00
        
 
        
;---Graphics Data from PlayerPal 2600---

; if we interlace each animaiton frame so we can safe a shift operation, and not need
; to use twice as much ROM
; this is jank, and kinda anoying, but should work
FrameU0
	.byte #0
        .byte #0
        .byte #%00000000;$1E
        .byte #%00000000;$1E
        .byte #%00011100;$1E
        .byte #%00110110;$1E
        .byte #%01011101;$1E
        .byte #%01100011;$1E
        .byte #%01111111;$1E
        .byte #%01010101;$1E
        .byte #%00010100;$1E
        .byte #%00010100;$1E
        .byte #%00001000;$1E
        .byte #%00001000;$1E


FrameU1
	;.byte #0, 
	.byte #0,    
        .byte #%00001000
        .byte #%00010100;$1E
        .byte #%00010100;$1E
        .byte #%00110110;$1E
        .byte #%01011101;$1E
        .byte #%01100011;$1E
        .byte #%01111111;$1E
        .byte #%01010101;$1E
        .byte #%00010100;$1E
        .byte #%00010100;$1E
        .byte #%00001000;$1E
        .byte #%00001000;$1E
FrameR0
	.byte #0
        .byte #0
        .byte #%00000000;$1E
        .byte #%00000000;$1E
        .byte #%00000000;$1E
        .byte #%00000000;$1E
        .byte #%00011100;$1E
        .byte #%00111000;$1E
        .byte #%00111110;$1E
        .byte #%00110011;$1E
        .byte #%00100110;$1E
        .byte #%00111000;$1E
        .byte #%00011100;$1E
        .byte #%00000000;$1E
FrameR1
	.byte #0
        .byte #0
        .byte #%00000000;$1E
        .byte #%00000000;$1E
        .byte #%00000000;$1E
        .byte #%00000000;$1E
        .byte #%00011100;$1E
        .byte #%00111000;$1E
        .byte #%01111110;$1E
        .byte #%10110011;$1E
        .byte #%01101110;$1E
        .byte #%00111000;$1E
        .byte #%00011100;$1E
        .byte #%00000000;$1E
FrameD0
	.byte #0
        .byte #0
        .byte #%00001000;$1E
        .byte #%00001000;$1E
        .byte #%00011100;$1E
        .byte #%00010100;$1E
        .byte #%01010101;$1E
        .byte #%01110111;$1E
        .byte #%01111111;$1E
        .byte #%01111111;$1E
        .byte #%00111110;$1E
        .byte #%00000000;$1E
        .byte #%00000000;$1E
        .byte #%00000000;$1E
FrameD1
	.byte #0
        .byte #0
        .byte #%00001000;$1E
        .byte #%00001000;$1E
        .byte #%00011100;$1E
        .byte #%00010100;$1E
        .byte #%01010101;$1E
        .byte #%01110111;$1E
        .byte #%01111111;$1E
        .byte #%01111111;$1E
        .byte #%00111110;$1E
        .byte #%00010100;$1E
        .byte #%00010100;$1E
        .byte #%00001000;$1E
FrameL0
	.byte #0
        .byte #0
    	.byte #%00000000;$1E
        .byte #%00000000;$1E
        .byte #%00000000;$1E
        .byte #%00000000;$1E
        .byte #%00111000;$1E
        .byte #%00011100;$1E
        .byte #%01111100;$1E
        .byte #%11001100;$1E
        .byte #%01100100;$1E
        .byte #%00011100;$1E
        .byte #%00111000;$1E
        .byte #%00000000;$1E
FrameL1
	.byte #0
        .byte #0
        .byte #%00000000;$1E
        .byte #%00000000;$1E
        .byte #%00000000;$1E
        .byte #%00000000;$1E
        .byte #%00111000;$1E
        .byte #%00011100;$1E
        .byte #%01111110;$1E
        .byte #%11001101;$1E
        .byte #%01110110;$1E
        .byte #%00011100;$1E
        .byte #%00111000;$1E
        .byte #%00000000;$1E
        
; Bitmap pattern for digits
DigitsBitmap ;;{w:8,h:5,count:10,brev:1};;
        .byte $EE,$AA,$AA,$AA,$EE
        .byte $22,$22,$22,$22,$22
        .byte $EE,$22,$EE,$88,$EE
        .byte $EE,$22,$66,$22,$EE
        .byte $AA,$AA,$EE,$22,$22
        .byte $EE,$88,$EE,$22,$EE
        .byte $EE,$88,$EE,$AA,$EE
        .byte $EE,$22,$22,$22,$22
        .byte $EE,$AA,$EE,$AA,$EE
        .byte $EE,$AA,$EE,$22,$EE
;---End Graphics Data---



        

	
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Epilogue

	org $fffc
        .word Start	; reset vector
        .word Start	; BRK vector
